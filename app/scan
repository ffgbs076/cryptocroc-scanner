export const runtime = "nodejs";

import { pickSideFromBTC } from "../../lib/btc";
import { scanMarket } from "../../lib/scan";

export async function GET(req: Request) {
  const url = new URL(req.url);

  // optioneel forceren: ?side=bull of ?side=bear
  const forced = url.searchParams.get("side");
  const side =
    forced === "bull" || forced === "bear" ? forced : await pickSideFromBTC();

  const data = await scanMarket({ side });

  return Response.json({
    ok: true,
    side,
    ts: Date.now(),
    data
  });
}